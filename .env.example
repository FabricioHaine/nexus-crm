# Ambiente local do Nexus CRM.
# Copie este arquivo para .env (nao versionado) e ajuste os valores.
# As variaveis abaixo sao lidas pelo backend Spring Boot.

# URL de conexao com o PostgreSQL (perfil "postgres")
DB_URL=jdbc:postgresql://localhost:5432/nexus_crm
DB_USERNAME=nexus
DB_PASSWORD=nexus

# Porta do backend (padrao: 8080)
SERVER_PORT=8080

# ==============================================================================
# Segredos - OBRIGATORIOS fora dos perfis dev/test
# ==============================================================================
# A aplicacao RECUSA iniciar se a chave ou a senha do administrador ainda
# forem as de desenvolvimento.

# Chave usada para assinar os tokens JWT (HMAC-SHA256).
# Minimo de 32 caracteres. Gere um valor aleatorio.
APP_JWT_SECRET=troque-esta-chave-por-um-valor-aleatorio-de-32-ou-mais-caracteres

# Validade do token de acesso, em minutos (padrao: 480 = 8 horas).
APP_JWT_EXPIRACAO_MINUTOS=480

# Usuario administrador criado na primeira execucao (idempotente).
APP_ADMIN_EMAIL=admin@nexuscrm.local
APP_ADMIN_SENHA=Nexus@2026
APP_ADMIN_NOME=Administrador

# ==============================================================================
# Sessao por cookie HttpOnly
# ==============================================================================
# Nome do cookie de sessao e do cookie de renovacao.
APP_SESSION_COOKIE=NEXUS_SESSION
APP_SESSION_REFRESH_COOKIE=NEXUS_REFRESH

# Marque como true em producao (exige HTTPS).
APP_SESSION_COOKIE_SECURE=false

# Strict exige que a API e o front-end estejam no mesmo site.
# Use None + Secure se estiverem em dominios diferentes.
APP_SESSION_COOKIE_SAME_SITE=Strict

# Validade do token de renovacao, em dias.
APP_SESSION_REFRESH_DIAS=7

# ==============================================================================
# Recuperacao de senha
# ==============================================================================
# Base do link enviado por e-mail.
APP_RECUPERACAO_URL=http://localhost:4200
APP_RECUPERACAO_VALIDADE_MINUTOS=60

# Remetente das notificacoes.
APP_MAIL_REMETENTE=nao-responda@nexus-crm.local

# Para enviar e-mails de verdade, configure o SMTP (Spring Boot):
# SPRING_MAIL_HOST=smtp.seuprovedor.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=usuario
# SPRING_MAIL_PASSWORD=senha
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Sem SMTP configurado, o link de recuperacao e registrado no log da API.

# ==============================================================================
# Docker Compose
# ==============================================================================
DB_NAME=nexus_crm
DB_PORT=5432
API_PORT=8080
FRONTEND_PORT=4200

# Origens do front-end autorizadas a chamar a API.
APP_CORS_ORIGINS=http://localhost:4200
